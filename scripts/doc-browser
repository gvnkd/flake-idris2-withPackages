#!/usr/bin/env bash
# doc-browser - Browse Idris2 package documentation
#
# Usage:
#   doc-browser list <docs-dir>                    # list packages
#   doc-browser show <docs-dir> <package>           # view index
#   doc-browser show <docs-dir> <package> <module>  # view module
#
# Or set DOCS_PATH env var and omit the docs-dir argument:
#   DOCS_PATH=/path/to/docs doc-browser list

set -euo pipefail

DOCS="${DOCS_PATH:-}"

# If first arg is not a subcommand, treat it as docs-dir
if [ $# -gt 0 ] && [ "$1" != "list" ] && [ "$1" != "show" ]; then
  DOCS="$1"
  shift
fi

if [ -z "$DOCS" ] && [ $# -gt 0 ]; then
  case "$1" in
    list|show)
      ;;
    *)
      DOCS="$1"
      shift
      ;;
  esac
fi

if [ -z "$DOCS" ]; then
  echo "Error: No docs directory specified." >&2
  echo "Usage: doc-browser <docs-dir> list|show ..." >&2
  echo "   or: DOCS_PATH=<docs-dir> doc-browser list|show ..." >&2
  exit 1
fi

# Detect if DOCS is a single package dir (has index.md directly)
# or a collection of packages (has subdirs with index.md)
is_single_package=false
if [ -f "$DOCS/index.md" ]; then
  is_single_package=true
fi

list_docs() {
  if [ "$is_single_package" = true ]; then
    echo "Package documentation (single package view):"
    echo ""
    # List modules
    for f in "$DOCS"/*.md; do
      [ -f "$f" ] || continue
      name=$(basename "$f" .md)
      [ "$name" = "index" ] && continue
      echo "  $name"
    done
  else
    echo "Available package documentation:"
    echo ""
    for dir in "$DOCS"/*; do
      [ -d "$dir" ] || continue
      name=$(basename "$dir")
      index="$dir/index.md"
      if [ -f "$index" ]; then
        echo "  $name"
      fi
    done
  fi
}

show_doc() {
  local pkg="$1"
  local module="${2:-}"

  if [ "$is_single_package" = true ]; then
    # Single package mode: pkg arg is actually a module name
    if [ -n "$pkg" ] && [ "$pkg" != "index" ]; then
      # User passed a module name directly
      local mod_file="$DOCS/${pkg}.md"
      if [ -f "$mod_file" ]; then
        cat "$mod_file"
        return
      fi
    fi
    # Show index
    cat "$DOCS/index.md"
  else
    # Collection mode: pkg is a package name
    local index="$DOCS/$pkg/index.md"
    if [ ! -f "$index" ]; then
      echo "No docs found for package '$pkg'" >&2
      echo "Run 'doc-browser list' to see available packages" >&2
      exit 1
    fi

    if [ -n "$module" ]; then
      local mod_file="$DOCS/$pkg/${module}.md"
      if [ -f "$mod_file" ]; then
        cat "$mod_file"
      else
        echo "No module docs found for '$module' in package '$pkg'" >&2
        echo "Available modules:" >&2
        ls "$DOCS/$pkg/" | grep '\.md$' | sed 's/\.md$//' | sed 's/^/  /' >&2
        exit 1
      fi
    else
      cat "$index"
    fi
  fi
}

case "${1:-list}" in
  list)
    list_docs
    ;;
  show)
    if [ -z "${2:-}" ]; then
      if [ "$is_single_package" = true ]; then
        show_doc "index"
      else
        echo "Usage: doc-browser show <package> [module]" >&2
        exit 1
      fi
    else
      show_doc "$2" "${3:-}"
    fi
    ;;
  *)
    echo "Usage: doc-browser list | doc-browser show [<package>] [module]" >&2
    exit 1
    ;;
esac
